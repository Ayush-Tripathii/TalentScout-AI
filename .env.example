# ==============================================================================
# TalentScout Production Deployment Template (.env.example)
# Copy to .env and configure secrets before launching.
# ==============================================================================

# Core Application Environment ('development' or 'production')
APP_ENV=production
DEBUG=false
PORT_API=8000
PORT_UI=5173

# Database Connection (SQLite local or Turso Cloud: libsql://your-db.turso.io)
DATABASE_URL=sqlite:///./data/talentscout.db
TURSO_AUTH_TOKEN=

# Cryptographic Security & JWT Authentication
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_64_CHAR_HEX_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS Allowed Origins (Comma-separated, never use '*' in production)
ALLOWED_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# Security Headers & Defense-in-Depth Middleware
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY_ENABLED=true
MAX_UPLOAD_SIZE_BYTES=10485760

# Rate Limiting Controls (Anti-Brute-Force & Anti-DoS)
RATE_LIMITING_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_GLOBAL_PER_MINUTE=180

# Webhook Alert Integrity (HMAC SHA-256 Signature)
WEBHOOK_SIGNING_SECRET=REPLACE_WITH_STRONG_HEX_WEBHOOK_SECRET

# Search Engine & Caching Controls
SEARCH_PROVIDER=duckduckgo
SEARXNG_URL=http://localhost:8080
CACHE_TTL_HOURS=24
RATE_LIMIT_DELAY_SECONDS=1.0

# Local AI LLM Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# External APIs (Optional - 100% Free Engine operates without these)
GITHUB_TOKEN=
HUNTER_API_KEY=
APOLLO_API_KEY=

# Inbound Email Parser (Gmail IMAP)
GMAIL_IMAP_SERVER=imap.gmail.com
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
GMAIL_CHECK_INTERVAL_MINUTES=15

# Google Sheets Inbound Sync
GOOGLE_SHEETS_CREDENTIALS_FILE=./config/google_service_account.json
GOOGLE_SHEET_ID=

# DPDP Act Statutory Compliance
RETENTION_DAYS=180
AUTO_FLAG_EXPIRED=true

# Explainable Ranking Weights
WEIGHT_MUST_HAVE=0.35
WEIGHT_NICE_HAVE=0.15
WEIGHT_EXPERIENCE=0.15
WEIGHT_LOCATION=0.15
WEIGHT_TITLE=0.10
WEIGHT_SEMANTIC=0.10
