# ==============================================================================
# TalentScout - Production Multi-Stage Hardened Dockerfile
# Stage 1: Build React SPA
# Stage 2: Minimal, Non-Root Python Runtime
# ==============================================================================

# STAGE 1: Frontend Build
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# STAGE 2: Python Backend Runtime
FROM python:3.11-slim-bookworm AS production

# Set security environment flags
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENV=production \
    PORT_API=8000

# Install minimal security tools & curl for healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged application user
RUN groupadd -g 1001 talentscout && \
    useradd -u 1001 -g talentscout -s /bin/bash -m talentscout

WORKDIR /app

# Install Python requirements
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt pyjwt

# Copy backend application source
COPY app/ ./app/
COPY config/ ./config/
COPY data/ ./data/

# Copy built frontend assets from Stage 1 into mounted dist folder
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

# Set directory permissions for unprivileged user
RUN mkdir -p /app/data /app/uploads && \
    chown -R talentscout:talentscout /app

# Switch to non-root user
USER talentscout

EXPOSE 8000

# Launch Uvicorn with hardened settings
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-server-header"]
