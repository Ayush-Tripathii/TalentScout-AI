# ==============================================================================
# TalentScout - Comprehensive Security & Deployment .gitignore
# ==============================================================================

# 1. Environment & Secret Credentials (NEVER commit secrets to VCS)
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
google_service_account*.json
credentials.json
client_secret*.json

# 2. Database & Data Storage (Prevent leaking PII and production candidates)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
recruiter.db
data/*
!data/.gitkeep

# 3. Uploaded Files & Applicant Resumes (DPDP Act Compliance)
uploads/*
!uploads/.gitkeep
temp/
tmp/

# 4. Logs, Scratch Scripts & Diagnostics
*.log
*.log.*
logs/
scratch/
scratch_*.py
.system_generated/
test_*.log

# 5. Python Runtime, Compilations & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.venv/
venv/
ENV/
env/

# 6. Frontend Build, Dependencies & Cache
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7. IDE & OS Artifacts
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
